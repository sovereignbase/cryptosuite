{
  "name": "@sovereignbase/cryptosuite",
  "version": "3.2.0",
  "description": "JS/TS runtime-agnostic, post-quantum, crypto-agile cryptography toolkit for identifiers, cipher messaging, message authentication, digital signatures, and key agreement.",
  "keywords": [
    "cryptography",
    "webcrypto",
    "noble",
    "cipher-messaging",
    "encryption",
    "decryption",
    "digital-signatures",
    "message-authentication",
    "signing",
    "verification",
    "key-agreement",
    "key-encapsulation",
    "key-decapsulation",
    "opaque-identifier",
    "jwk",
    "hmac-256",
    "aes-ctr-256",
    "ml-dsa-87",
    "ml-kem-1024",
    "bun",
    "deno",
    "node",
    "browser",
    "edge-runtime",
    "typescript",
    "esm",
    "cjs",
    "bytecodec",
    "sovereignbase"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./CipherMessage": {
      "types": "./dist/CipherMessage/index.d.ts",
      "import": "./dist/CipherMessage/index.js",
      "require": "./dist/CipherMessage/index.cjs",
      "default": "./dist/CipherMessage/index.js"
    },
    "./DigitalSignature": {
      "types": "./dist/DigitalSignature/index.d.ts",
      "import": "./dist/DigitalSignature/index.js",
      "require": "./dist/DigitalSignature/index.cjs",
      "default": "./dist/DigitalSignature/index.js"
    },
    "./Identifier": {
      "types": "./dist/Identifier/index.d.ts",
      "import": "./dist/Identifier/index.js",
      "require": "./dist/Identifier/index.cjs",
      "default": "./dist/Identifier/index.js"
    },
    "./KeyAgreement": {
      "types": "./dist/KeyAgreement/index.d.ts",
      "import": "./dist/KeyAgreement/index.js",
      "require": "./dist/KeyAgreement/index.cjs",
      "default": "./dist/KeyAgreement/index.js"
    },
    "./MessageAuthentication": {
      "types": "./dist/MessageAuthentication/index.d.ts",
      "import": "./dist/MessageAuthentication/index.js",
      "require": "./dist/MessageAuthentication/index.cjs",
      "default": "./dist/MessageAuthentication/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "npm run build:package && npm run build:docs",
    "build:package": "tsdown",
    "build:docs": "typedoc",
    "test": "npm run build && npm run typecheck && npm run test:vitest && npm run test:e2e",
    "typecheck": "tsc --noEmit --project test/tsconfig.json",
    "test:vitest": "vitest run --coverage",
    "test:e2e": "node test/e2e/run.mjs",
    "bench": "npm run build && node benchmark/bench.js",
    "prepare": "husky",
    "prepublishOnly": "npm run test && npm run bench"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/cryptosuite.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/cryptosuite/issues"
  },
  "homepage": "https://github.com/sovereignbase/cryptosuite#readme",
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@sovereignbase/bytecodec": "^2.0.1",
    "@sovereignbase/utils": "^2.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "edge-runtime": "^4.0.1",
    "esbuild": "^0.28.2",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "wrangler": "4.150.0"
  }
}
